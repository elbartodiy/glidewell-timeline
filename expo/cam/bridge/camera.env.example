# Copy to camera.env and fill in. camera.env is ignored by git.
# IP: Tapo app → the camera → ⚙ → Device Info → IP address
# USER/PASS: Tapo app → the camera → ⚙ → Advanced Settings → Camera Account
#   (a separate login for the camera itself, NOT your TP-Link account)
# If the password has @ : / # ? in it, pick another one — it goes inside a URL.
TAPO_IP=192.168.1.50
TAPO_USER=
TAPO_PASS=
